{
  "name": "a7",
  "version": "0.1.0",
  "private": true,
  "description": "A7 — Multi-Strategy Research, Backtest & Live Trading System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/scripts/seed.ts",
    "research:strategies": "tsx src/scripts/research-strategies.ts",
    "backtest:run": "tsx src/scripts/run-backtest.ts",
    "signals:generate": "tsx src/scripts/generate-signals.ts",
    "paper:update-pnl": "tsx src/scripts/update-pnl.ts",
    "full-cycle": "npm run signals:generate || true && npm run paper:update-pnl || true && npm run review:outcomes || true",
    "review:outcomes": "tsx src/scripts/review-outcomes.ts",
    "update:params": "tsx src/scripts/update-params.ts",
    "report:daily": "tsx src/scripts/daily-report.ts",
    "webhook:test": "tsx src/scripts/test-webhook.ts",
    "test": "tsx src/scripts/run-tests.ts",
    "perf": "tsx src/scripts/perf-report.ts",
    "status": "tsx src/scripts/status-check.ts",
    "go": "npm run status && npm run signals:generate && npm run paper:update-pnl && npm run review:outcomes && npm run status",
    "watch": "npm run go"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}